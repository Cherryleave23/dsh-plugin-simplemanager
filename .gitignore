# 依赖
node_modules/
**/node_modules/
.pnpm-store/

# 构建产物
lib/
dist/

# 版本适配断点状态（git 走源码）
_adapt_work/

# 类型检查临时环境（依赖指向共享 store，不随源码分发）
typecheck-tmp/node_modules/

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log

# smoke 测试临时目录（不入库）
.smoketmp/

# 已发布版本目录（正式安装副本，不入库；每个 dsh-v*/ 对应一个已上传版本）
dsh-v*/
# preview 为最新开发源（git 入库），故显式不忽略其键产物外的一切
!preview/
preview/lib/