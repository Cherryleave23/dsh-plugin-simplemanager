{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"],
    "noEmitOnError": false,
    "paths": {
      "@deepseek-ai/dsh-tools": ["../dsh-official/deepseek-harness-v0.1.1-rc.2/packages/core/tools/lib/types/index.d.ts"]
    }
  },
  "include": ["src/index.ts", "src/host.ts", "src/shims.d.ts"]
}